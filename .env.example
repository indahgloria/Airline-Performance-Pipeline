# Copy to .env and edit. .env is git-ignored.
# Postgres.app on Mac: user = your Mac username, no password.
PGHOST=localhost
PGPORT=5432
PGDATABASE=flights
PGUSER=your_mac_username
PGPASSWORD=

# If you use docker compose instead, use:
# PGUSER=pipeline
# PGPASSWORD=pipeline
# PGPORT=5433

# ---- Optional: AWS ----------------------------------------------------------------
# S3 landing zone. Leave S3_BUCKET empty to keep everything local.
# AWS credentials come from `aws configure`, not from this file.
# S3_BUCKET=your-bucket-name
# S3_PREFIX=raw/bts/
# AWS_DEFAULT_REGION=us-west-2

# Amazon RDS for PostgreSQL instead of a local database:
# PGHOST=your-db.xxxxxxxx.us-west-2.rds.amazonaws.com
# PGPORT=5432
# PGDATABASE=flights
# PGUSER=pipeline
# PGPASSWORD=your-rds-password
# PGSSLMODE=require
